[gd_scene format=3]

[ext_resource type="Script" path="res://GeneralNodes/VictoryScreen/victory_screen.gd" id="1_victory_script"]
[ext_resource type="Theme" path="res://GeneralNodes/UI/tema_santuario.tres" id="2_tema"]

[sub_resource type="StyleBoxFlat" id="Estilo_cabecalho"]
bg_color = Color(0.11, 0.153, 0.259, 1)
border_width_bottom = 2
border_color = Color(0.851, 0.298, 0.569, 1)
content_margin_left = 10.0
content_margin_top = 6.0
content_margin_right = 10.0
content_margin_bottom = 6.0

[node name="VictoryScreen" type="CanvasLayer"]
process_mode = 3
script = ExtResource("1_victory_script")

[node name="Control" type="Control" parent="."]
unique_name_in_owner = true
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_tema")

[node name="Overlay" type="ColorRect" parent="Control"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.027, 0.043, 0.086, 0.88)

[node name="CenterContainer" type="CenterContainer" parent="Control"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Painel" type="PanelContainer" parent="Control/CenterContainer"]
custom_minimum_size = Vector2(250, 0)
layout_mode = 2

[node name="Margem" type="MarginContainer" parent="Control/CenterContainer/Painel"]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="VBox" type="VBoxContainer" parent="Control/CenterContainer/Painel/Margem"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Cabecalho" type="PanelContainer" parent="Control/CenterContainer/Painel/Margem/VBox"]
layout_mode = 2
theme_override_styles/panel = SubResource("Estilo_cabecalho")

[node name="TituloLabel" type="Label" parent="Control/CenterContainer/Painel/Margem/VBox/Cabecalho"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.21, 0.84, 0.91, 1)
theme_override_font_sizes/font_size = 14
text = "FASE 1 CONCLUÍDA"
horizontal_alignment = 1

[node name="MensagemLabel" type="Label" parent="Control/CenterContainer/Painel/Margem/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Objetivo cumprido."
horizontal_alignment = 1
autowrap_mode = 2

[node name="Separador" type="HSeparator" parent="Control/CenterContainer/Painel/Margem/VBox"]
unique_name_in_owner = true
layout_mode = 2

[node name="ComandosTitulo" type="Label" parent="Control/CenterContainer/Painel/Margem/VBox"]
